# ---------- Food Finder Cambodia : backend settings ----------
# Copy this file to ".env" and change the values.

# Where the API listens
PORT=5000
NODE_ENV=development

# MongoDB connection (local MongoDB default shown)
MONGODB_URI=mongodb://127.0.0.1:27017/food_finder_cambodia

# Secret used to sign login tokens. Use a long random string (32+ characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=bvbkvbjvbdfkvbfdkjbvdfjkvdfvkfbvkf

# Website address(es) allowed to call the API (comma separated)
CLIENT_URL=http://localhost:5173

# Public address of this API. Used to build image links such as
# http://localhost:5000/uploads/foods/abc.webp
PUBLIC_URL=http://localhost:5000

# Login cookie settings. Keep "lax" when the site and API share a domain
# (the default dev setup does this through the Vite proxy).
# If the site and API are on different domains over HTTPS, use "none".
COOKIE_SAMESITE=lax

# true  = new reviews wait for admin approval before they show up
# false = reviews show up immediately (admin can still delete them)
REVIEW_MODERATION=false
